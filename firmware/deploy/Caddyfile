# managed by firmware — generated by deploy/setup-droplet.sh
{
	email {{EMAIL}}
	# certificates for company subdomains (<ticker>.{{SITES_DOMAIN}}) are issued on first visit,
	# only for tickers that exist (checked by the app)
	on_demand_tls {
		ask http://127.0.0.1:{{PORT}}/api/sites/allowed
	}
}

{{DOMAIN}} {
	encode zstd gzip
	# agent shifts + launches can take a while
	reverse_proxy 127.0.0.1:{{PORT}} {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output file /var/log/caddy/firmware.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

# company websites on their own subdomain (certificates issued on demand, only for real companies)
*.{{SITES_DOMAIN}} {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:{{PORT}}
	header -Server
}
