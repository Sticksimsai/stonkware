# ── Database ──────────────────────────────────────────────
# libSQL / SQLite. Local file in dev; Turso (or any libSQL server) in production:
#   DATABASE_URL="libsql://your-db.turso.io"
DATABASE_URL="file:./firmware.db"
DATABASE_AUTH_TOKEN=""

# ── Mode ──────────────────────────────────────────────────
# "mock" = simulated chain (fake launches, payments, fees) — the agent itself is real if a model key is set.
# "live" = real pump.fun launches and real SOL.
FIRMWARE_MODE="mock"

# ── Solana ────────────────────────────────────────────────
# Use a paid RPC (Helius, Triton, QuickNode) in production.
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
# Public URL of THIS backend (agent websites, token metadata and images are served from it).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Company websites are served at https://<ticker>.SITES_DOMAIN (needs DNS:  *  A  <droplet IP>).
# Leave empty to serve them at <backend>/s/<ticker> instead.
SITES_DOMAIN=""
# Public URL of the website (frontend). Agents link buyers to storefronts here.
APP_URL="http://localhost:3001"
# Frontend origins allowed to call the API (comma-separated; supports "*.lovable.app"; "*" = any).
ALLOWED_ORIGINS="http://localhost:3001,http://localhost:5173,*.vercel.app,*.lovable.app,*.lovableproject.com"

# ── Vault ─────────────────────────────────────────────────
# 32-byte hex key that encrypts every treasury key. `npm run keygen`. Keep it in a secret manager.
VAULT_KEY=""

# ── Meteora launchpad (Dynamic Bonding Curve) ─────────────
# Hypeware is the DBC "partner". Create the config once:  npm run meteora:config
# then paste the printed address here. PARTNER_KEYPAIR is the partner/fee-claimer wallet
# (path to a solana-keygen JSON file, or a base58 secret) — used only by the scripts, never by the web app.
# Launch venue: "stonkfun" (default: Raydium LaunchLab under StonkFun's platform, any StonkFun quote token)
# or "meteora" (Hypeware's own DBC config, needs DBC_CONFIG + PARTNER_KEYPAIR).
LAUNCH_VENUE="stonkfun"
# Hypeware's share of each company's creator fees on StonkFun, in bps (2000 = 20%)
CREATOR_FEE_SHARE_BPS="2000"
# STONKFUN_API_URL="https://www.stonkfun.xyz"
# Meteora venue only:
DBC_CONFIG=""
PARTNER_KEYPAIR=""
# Economics baked into the config (only read when creating a config):
# 2% per trade after the anti-sniper window
DBC_FEE_BPS="200"
# anti-sniper: fee starts at 50%…
DBC_START_FEE_BPS="5000"
# …and decays to DBC_FEE_BPS over 2 minutes
DBC_ANTI_SNIPER_SECONDS="120"
# of the post-Meteora fee: 75% company treasury, 25% Hypeware
DBC_CREATOR_SHARE_PCT="75"
DBC_INITIAL_MCAP_SOL="30"
# graduates to Meteora DAMM v2 here
DBC_MIGRATION_MCAP_SOL="400"
# Post-graduation buybacks route through Jupiter
JUPITER_API_URL="https://lite-api.jup.ag/swap/v1"

# ── Platform ──────────────────────────────────────────────
# Receives the 5% revenue share + compute reimbursements.
PLATFORM_FEE_WALLET=""
# Optional: pin token metadata to IPFS. Otherwise Hypeware serves it at /api/meta/<id> (keep the domain stable).
PINATA_JWT=""
CRON_SECRET="change-me"

# ── The agent's mind (OpenRouter: Claude, GPT, Gemini, Grok, DeepSeek, Qwen…) ──
# Without a key, agents run a scripted offline shift (good for UI dev).
OPENROUTER_API_KEY=""

# ── The agent's browser ───────────────────────────────────
# Browserbase gives the embeddable LIVE view. Otherwise local Chromium (screenshots), otherwise text-only fetch.
BROWSERBASE_API_KEY=""
BROWSERBASE_PROJECT_ID=""
CHROMIUM_PATH=""
# Dev only: let the agent open localhost URLs (e.g. its own site on your machine).
ALLOW_PRIVATE_URLS="0"

# ── Agent pacing & costs ──────────────────────────────────
AGENT_MAX_STEPS="40"
AGENT_SHIFT_EVERY_MIN="30"
AGENT_MAX_CONCURRENT="3"
# Optional safety caps. Leave empty for full control (no limits).
AGENT_MAX_TRANSFER_SOL=""
AGENT_MAX_DAILY_SPEND_SOL=""
SOL_USD="150"
BROWSER_USD_PER_MIN="0.002"

# Scheduler runs inside `npm start`. Set to 0 if you run `npm run worker` separately.
RUN_SCHEDULER="1"

# ── Media studio (Higgsfield API: AI images + video) ──
# Create a key at https://console.higgsfield.ai and add credit. Put it in .env.local on the server
# (never commit it) as HF_CREDENTIALS="key-id:key-secret". The two separate variables below also work.
# Test it with: npm run higgsfield:example   (one billable 5s Seedance 2.5 render)
# Renders are billed to each company's treasury at the prices below and repaid to PLATFORM_FEE_WALLET.
HF_CREDENTIALS=""
HIGGSFIELD_API_KEY_ID=""
HIGGSFIELD_API_KEY_SECRET=""
# Model endpoints (any model path from the Higgsfield console works)
HIGGSFIELD_IMAGE_ENDPOINT="higgsfield-ai/soul/v2/standard"
HIGGSFIELD_VIDEO_ENDPOINT="bytedance/seedance-2.5/text-to-video"
# 480p | 720p | 1080p
HIGGSFIELD_VIDEO_RESOLUTION="720p"
HIGGSFIELD_I2V_ENDPOINT="kling-video/v3.0-turbo/image-to-video"
# What the treasury is billed (USD). Keep at or above Higgsfield's price for the models above.
HIGGSFIELD_IMAGE_USD="0.01"
HIGGSFIELD_VIDEO_USD_PER_SEC="0.21"
# Optional cap on video seconds per company per day (empty = unlimited, the treasury is the limit)
MEDIA_MAX_VIDEO_SEC_PER_DAY=""
# Where files are stored (default: a "media" folder next to the database)
MEDIA_DIR=""

# ── Bots (Telegram / Discord) ──
# Creators connect bot accounts on their company page; nothing to set here. Optional:
# model for the ai() helper inside bots (billed to the company treasury)
BOT_AI_MODEL="openai/gpt-4o-mini"
BOT_MAX_EVENTS_PER_MIN="60"

# ── Print-on-demand (Printful) ──
# Private token from https://developers.printful.com (Manual order / API store). Printful bills this
# account in USD; each order's cost is charged to the company treasury and repaid like compute.
PRINTFUL_API_KEY=""
PRINTFUL_STORE_ID=""
# Submit orders for fulfillment automatically: "1" yes, "0" save as drafts.
# Default: yes only on mainnet live; drafts on devnet/mock so testing never prints real orders.
PRINTFUL_CONFIRM=""
# Shipping estimate (USD) used for the minimum-price check
MERCH_SHIPPING_USD="8"

# ── Flagship (Hypeware's own token, launched outside the launchpad) ──
# Share of Hypeware's platform revenue (5% sales cut + Meteora partner fees) sent to the flagship's treasury.
FLAGSHIP_SHARE_PCT="50"

# ── Self-improvement (the flagship agent improves Hypeware's own code via pull requests) ──
# Fine-grained GitHub token for THIS repo only: Contents R/W, Pull requests R/W, Checks R, Metadata R.
# Put it in .env.local on the server (never commit it).
GITHUB_TOKEN=""
GITHUB_REPO="dev79-code/firmware"
GITHUB_BASE_BRANCH="main"
# Monorepo folders (relative to the repo root)
SELFDEV_BACKEND_DIR="firmware"
SELFDEV_FRONTEND_DIR="firmware-web"
# Max open pull requests at once, and steps per flagship shift
SELFDEV_MAX_OPEN="4"
FLAGSHIP_MAX_STEPS="80"

# ── Vanity contract addresses (launches get a CA ending in e.g. "firm") ──
# Pool managed with: npm run vanity -- import <keypair.json…> | grind --suffix firm --count 10 | status
# Used on mainnet live only (devnet/mock testing never spends them) unless VANITY_ANY_CLUSTER="1".
VANITY_MINTS="1"
VANITY_SUFFIX="firm"
# Hours an unfunded launch keeps its vanity address before it goes back to the pool
VANITY_HOLD_HOURS="6"

# ── Shift pacing (agents work as often as their treasury can afford) ──
# next gap = typical shift cost ÷ (24h income per hour + spendable balance / RUNWAY hours), clamped to MIN..MAX minutes
AGENT_MIN_GAP_MIN="3"
AGENT_MAX_GAP_MIN="360"
AGENT_RUNWAY_HOURS="24"
# raise this when many agents are active (each running shift = one model loop + optional browser)
AGENT_MAX_CONCURRENT="3"

# ── Hyperliquid (the tech chain: USDC treasury, agent trading, payments). Tokens still launch on Solana. ──
# Each company gets its own Hyperliquid account + an API wallet that can trade but never withdraw.
# "testnet" (default) or "mainnet". Independent of FIRMWARE_MODE.
HL_NETWORK="testnet"
# Optional: your own Hyperliquid API node.
# HL_API_URL=""
# Optional hard cap (USD) on any single transfer out of a company's Hyperliquid account.
# HL_MAX_TRANSFER_USD=""
